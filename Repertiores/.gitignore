# Never commit learner data — it contains PHI (names, DOBs, behavior records).
data/

# Demo media / screencasts (large binaries; mp4 already ignored repo-wide).
docs/media/
*.mp4
*.webm
*.m4a

# Python / Streamlit cruft
__pycache__/
*.pyc
*.tmp
.streamlit/secrets.toml

# Desktop-app build artifacts
dist/
build/
build_iconset/
AppIcon.icns

# ...but DO track the source icon (the repo root ignores *.png); the build
# regenerates AppIcon.icns from it.
!icon-1024.png
